{
  "name": "Blazememo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npm run android:local",
    "android:local": "BLAZE_API_ENV=local react-native run-android",
    "android:aws": "BLAZE_API_ENV=aws react-native run-android",
    "android:production": "BLAZE_API_ENV=production react-native run-android",
    "ios": "BLAZE_API_ENV=local react-native run-ios --no-packager",
    "ios:local": "BLAZE_API_ENV=local react-native run-ios --no-packager",
    "ios:aws": "BLAZE_API_ENV=aws react-native run-ios --no-packager",
    "ios:production": "BLAZE_API_ENV=production react-native run-ios --no-packager",
    "postinstall": "patch-package",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "npm run start:local",
    "start:local": "BLAZE_API_ENV=local react-native start --reset-cache",
    "start:aws": "BLAZE_API_ENV=aws react-native start --reset-cache",
    "start:production": "BLAZE_API_ENV=production react-native start --reset-cache",
    "test": "jest"
  },
  "dependencies": {
    "@10play/tentap-editor": "^1.0.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "^9.1.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native/new-app-screen": "0.85.2",
    "@react-navigation/bottom-tabs": "^7.16.0",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/native-stack": "^7.15.0",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-paragraph": "^3.30.0",
    "@tiptap/extension-text": "^3.30.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.1",
    "lottie-react-native": "^7.3.8",
    "react": "^19.2.3",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.2",
    "react-native-date-picker": "^4.3.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.25.0",
    "react-native-svg": "^15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^14.0.1",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "^0.85.2",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
